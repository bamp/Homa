# Copie para .env e ajuste se quiser: cp .env.example .env

# Ambiente exibido na interface e em /api/info (local, staging, producao)
APP_ENV=local
# Porta da aplicação na sua máquina
APP_PORT=8080
# Carrega dicas de exemplo quando o banco está vazio
DADOS_EXEMPLO=true

# Banco PostgreSQL do Compose
POSTGRES_DB=homa
POSTGRES_USER=homa
POSTGRES_PASSWORD=troque-esta-senha
